# ============================================================
# Prism 环境配置文件
# 复制为 .env 后填写实际值
# ============================================================

# --- LLM API Keys（按品牌名字母序） ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=
CUSTOM_API_KEY=

# --- Anthropic ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-fable-5

# --- DeepSeek ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Kimi ---
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# --- OpenAI ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol

# --- 通义千问 ---
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max

# --- 智谱 ---
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2

# --- 自定义 ---
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# --- 当前生效厂商（0=Anthropic 1=DeepSeek 2=Kimi 3=OpenAI 4=通义千问 5=智谱 6=自定义） ---
# 所有 AI 功能（文档分析/行为体生成/仿真/结果分析）统一使用该厂商，可在应用「设置」页修改
LLM_ACTIVE_VENDOR=0

# --- 仿真与调用参数（均可在应用「设置」页修改） ---
SIM_MAX_ROUNDS=12
LLM_DECISION_TEMPERATURE=0.35
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=3
