# ============================================================
# Prism 环境配置文件
# 复制为 .env 后填写实际值
# API Key 建议使用系统钥匙串存储，.env 仅作开发兜底
# ============================================================

# --- LLM API Keys（留空则由应用内首次配置引导填写）---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM 默认参数 ---
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=30

# --- 仿真默认值 ---
SIM_MAX_ROUNDS=12
SIM_HOURS_PER_ROUND=1
SIM_AGENT_COUNT=7
